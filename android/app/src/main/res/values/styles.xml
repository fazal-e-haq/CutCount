<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme: applied while the Android process is starting (LIGHT mode).
        This is what the user sees before Flutter draws its first frame.
        - windowBackground points to our custom launch_background.xml drawable
        - windowFullscreen true: hides the status bar during splash for a clean full-screen look
        - Automatically dismissed when Flutter renders its first widget frame
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        NormalTheme: applied immediately after Flutter starts rendering.
        windowBackground is transparent so the Flutter widget tree shows through cleanly.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
