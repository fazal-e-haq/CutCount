<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme: applied while the Android process is starting (DARK mode).
        Uses the same orange splash — brand consistency across light/dark system modes.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        NormalTheme: applied immediately after Flutter starts rendering (DARK mode).
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
