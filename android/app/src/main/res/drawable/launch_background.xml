<?xml version="1.0" encoding="utf-8"?>
<!--
    Native splash for LIGHT mode (and default, pre-Android 12).
    Shown by Android while the Dart/Flutter engine is loading.
    Automatically dismissed when Flutter draws its first frame.

    Layout:
      - Layer 1: solid brand orange background (#E95401)
      - Layer 2: logo centered on top
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid brand orange background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E95401"/>
        </shape>
    </item>

    <!-- Centered app logo (logo.png from mipmap) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground"/>
    </item>

</layer-list>
